# Local demonstration only; never use example credentials in production.
VETPATH_ENV=demo
DATABASE_URL=postgresql://vetpath:vetpath@localhost:5432/vetpath
BETTER_AUTH_URL=http://localhost:3000
# Generate two independent high-entropy values, each at least 32 characters.
BETTER_AUTH_SECRET=
RATE_LIMIT_SECRET=
# Only for pilot deployments behind a trusted proxy that overwrites this header.
TRUSTED_CLIENT_IP_HEADER=
# Optional service-account JSON, server and worker only. Never commit real credentials.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Private files are stored outside the public web root. Back this up separately.
PRIVATE_STORAGE_DIR=./private-data
